# Copy to .env (gitignored) and fill in. Never commit .env.

# Google Cloud project for Earth Engine. Ask Fiona for the value.
EE_PROJECT=

# LLM for the verdict prose (scripts/07_verdicts.py, #51). Any OpenAI-compatible
# chat/completions endpoint works; Gemini's free tier is the default choice.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
